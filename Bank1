void SystemManagemen()
{
    vector <stClient> vClients = LoadClientsDataFromFile(ClientsFileName);

    stClient Client;

    string AccountNumber;

    enChoise choise = enChoise::ShowClient;
    
    while (true)
    {
        system("cls");

        ShowMainMenueScreen();
        choise = ReadChoise();

        if (choise==enChoise::Exit)
        {
            PrintScreen("Program Ends  :-)");

            break;
        }
        
        switch (choise)
        {
        case enChoise::ShowClient:
            system("cls");
            vClients = LoadClientsDataFromFile(ClientsFileName);
            ShowClientList(vClients);
            break;

        case enChoise::AddNew:

            PrintScreen("Add New Clients Screen");

            AddClients();

            break;

        case enChoise::DeleteClient:
            PrintScreen("Delete Client Screen");

            vClients = LoadClientsDataFromFile(ClientsFileName);
            AccountNumber = ReadClineAccountNumber();
            DeleteClientByAccountNumber(AccountNumber, vClients);
            break;

        case enChoise::UpdateClient:
            PrintScreen("Update Client Screen");

            AccountNumber = ReadClineAccountNumber();
            UpdateClientByAccountNumber(AccountNumber, vClients);
            break;

        case enChoise::FindClient:
            PrintScreen("Find Client Screen");

            AccountNumber = ReadClineAccountNumber();
            if (FindClientByAccountNumber(AccountNumber, vClients, Client))
            {
                PrintClientCard(Client);
            }
            else
            {
                cout << "\nClient with Account Number[" << AccountNumber
                    << "] is not found!\n";
            }
            break;

        }

        cout << "\n\nPress any key to go back to Main Menue...";
        system("pause>0");

    }

    
}

int main()
{
    SystemManagemen();

    system("pause>0");


    return 0;
}
