const string ClientsFileName = "Clients.txt";

enum enChoise
{
    ShowClient = 1, AddNew = 2, DeleteClient = 3, UpdateClient = 4, FindClient = 5, Exit = 6
};

struct stClient
{
    string AccountNumber;
    string PinCode;
    string Name;
    string Phone;
    double AccountBalance;
    bool MarkForDelete = false;
};

